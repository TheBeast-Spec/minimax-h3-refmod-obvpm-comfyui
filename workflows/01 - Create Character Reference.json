      "inputs": [],
      "outputs": [],
      "widgets_values": [
        "# Create a character RefMod\n\n1. Upload your own portrait and full-body reference of the same character.\n2. Select an installed MiniMax H3 VIDEO VAE.\n3. Choose a unique RefMod name before running; an existing file with that name can be replaced.\n4. Run to save under models/refmods, then refresh the RefMod list in your video workflow.\n\nBoth connected image inputs start blank. For one reference, remove the unused image loader and its connection.\nRequires ComfyUI-MiniMaxH3Mod with standalone creator support (0.2.6 or newer)."
      ],
      "color": "#432",
      "bgcolor": "#653"
